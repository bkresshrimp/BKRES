# FPT Mail Configuration
FPT_MAIL_USER=your_email@fpt.com
FPT_MAIL_PASSWORD=your_password
FPT_MAIL_HOST=mail.fpt.com
FPT_MAIL_PORT=993
FPT_CRON_TIME=*/5 * * * *
FPT_MAIL_ACTIVE=true
FPT_MAX_EMAILS=10

# FPT Mail Configuration 2 (Optional - for multiple accounts)
FPT_MAIL_USER_2=backup@fpt.com
FPT_MAIL_PASSWORD_2=backup_password
FPT_MAIL_HOST_2=mail.fpt.com
FPT_MAIL_PORT_2=993
FPT_CRON_TIME_2=*/10 * * * *
FPT_MAIL_ACTIVE_2=false
FPT_MAX_EMAILS_2=5

# SSL/TLS Configuration
FPT_CA_CERT=
FPT_REJECT_UNAUTHORIZED=true

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=Asia/Ho_Chi_Minh